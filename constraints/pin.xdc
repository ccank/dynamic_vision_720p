# key_user: original / median toggle, pressed = low
set_property PACKAGE_PIN A26 [get_ports key_user]
set_property IOSTANDARD LVCMOS33 [get_ports key_user]
# key2: cycle video source OV5640 -> test1 -> test2, pressed = low
set_property PACKAGE_PIN A25 [get_ports key2]
set_property IOSTANDARD LVCMOS33 [get_ports key2]


