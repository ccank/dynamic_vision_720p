set_property PACKAGE_PIN E24 [get_ports iic_sda]
set_property IOSTANDARD LVCMOS33 [get_ports iic_scl]
set_property IOSTANDARD LVCMOS33 [get_ports iic_sda]
set_property PACKAGE_PIN E29 [get_ports rstn_out]
