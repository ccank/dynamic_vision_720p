#============================================================
# timing_exceptions.xdc
# Asynchronous clock-domain crossing (CDC) constraints and reset cuts
# for the OV5640 720P motion-adaptive video design (Kintex-7).
#
# Three mutually-asynchronous clock groups:
#   WIZ : every clock generated by (or fed into) the main clk_wiz MMCM.
#         clk_out3 / clk_out4 are the same frequency with a phase shift and
#         MUST stay in one group so their known phase relationship is still
#         analysed normally.
#   CAM : the external OV5640 DVP pixel clock (independent oscillator).
#   MIG : every clock owned by the MIG MMCM/PLL and DDR3 PHY (iserdes /
#         oserdes / ui_clk ...). The MIG constrains its own internal arcs.
#
# Pixel data crosses domains only inside the asynchronous wr/rd FIFOs (the FIFO
# IP already cuts those paths); control crosses through multi-stage
# synchronizers. Cutting the inter-group paths here removes the false CDC setup
# violations and lets the router spend its effort on the real same-domain paths.
#============================================================

#------------------------------------------------------------
# 0) Collect the clock objects (quiet: never error on an empty match)
#------------------------------------------------------------
set wiz_clks [get_clocks -quiet { \
    sys_clk_p \
    u_clk_wiz/inst/clk_in1 \
    clkfbout_clk_wiz_0 \
    clk_out1_clk_wiz_0 \
    clk_out2_clk_wiz_0 \
    clk_out3_clk_wiz_0 \
    clk_out4_clk_wiz_0 \
    clk_out5_clk_wiz_0 }]

set cam_clks [get_clocks -quiet cam_pclk]

# All MIG/PHY generated clocks share one of these name fragments; none of the
# clk_wiz clock names match these patterns, so the groups never overlap.
set mig_clks [get_clocks -quiet -filter { \
    NAME =~ *iserdes*            || \
    NAME =~ *oserdes*            || \
    NAME =~ clk_pll_i            || \
    NAME =~ *mmcm*               || \
    NAME =~ *refclk*             || \
    NAME =~ pll_clk*             || \
    NAME =~ sync_pulse }]

#------------------------------------------------------------
# 1) Cut every path between the three asynchronous groups
#------------------------------------------------------------
set_clock_groups -asynchronous \
    -group $wiz_clks \
    -group $cam_clks \
    -group $mig_clks

#------------------------------------------------------------
# 2) Board reset is asynchronous to every clock
#------------------------------------------------------------
set_false_path -from [get_ports sys_rst_n]

#------------------------------------------------------------
# 3) MIG calibration-done quasi-statically releases the safe reset; cut its
#    recovery/removal arcs.
#------------------------------------------------------------
set_false_path -from [get_cells -hier -quiet -filter {NAME =~ *init_calib_complete_reg}]

#------------------------------------------------------------
# 4) Flag the first stage of each remaining CDC synchronizer so the placer
#    keeps the two flip-flops together. (-quiet: names absent in this build
#    simply resolve to an empty list and are skipped.)
#------------------------------------------------------------
set_property ASYNC_REG TRUE [get_cells -hier -quiet -filter { \
        NAME =~ *u_nr_top/wl0_reg                  || \
        NAME =~ *u_nr_top/rl0_reg                  || \
        NAME =~ *u_ddr3_fifo_ctrl/rd_load_d0_reg }]
set_false_path -to [get_cells -hier -quiet -filter { \
        NAME =~ *u_nr_top/wl0_reg                  || \
        NAME =~ *u_nr_top/rl0_reg                  || \
        NAME =~ *u_ddr3_fifo_ctrl/rd_load_d0_reg }]
